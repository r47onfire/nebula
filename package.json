{
    "name": "@r47onfire/nebula",
    "version": "0.0.0",
    "private": true,
    "description": "Packrat parser engine with left-recursion support, producing a round-trippable CST.",
    "main": "src/index.ts",
    "exports": {
        ".": {
            "import": "./src/index.ts",
            "types": "./src/index.ts"
        },
        "./compile": {
            "import": "./src/compile.ts",
            "types": "./src/compile.ts"
        }
    },
    "type": "module",
    "sideEffects": false,
    "scripts": {
        "build": "bun run scripts/build.ts",
        "build:docs": "bun typedoc",
        "build:website": "bun run --sequential clean:dist clean:docs prepare build:docs",
        "clean:dist": "rm -rf dist/*",
        "clean:docs": "rm -rf docs/*",
        "dev": "bun run --parallel \"dev:*\"",
        "dev:serve": "python3 -m http.server -d docs",
        "dev:watch": "bun nodemon -e js,json,ts,css,md,html -w . --exec \"bun run build:website\"",
        "prepare": "bun run build --minify",
        "test": "bun test",
        "test:watch": "bun test --watch"
    },
    "nodemonConfig": {
        "ignore": [
            "**/docs/**",
            "**/dist/**",
            "**/skills/**"
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/r47onfire/nebula.git"
    },
    "homepage": "https://r47onfire.github.io/nebula",
    "keywords": [
        "parser",
        "packrat",
        "peg",
        "grammar",
        "left-recursion",
        "cst"
    ],
    "author": "dragoncoder047",
    "license": "AGPL-3.0-only",
    "devDependencies": {
        "@types/bun": "^1.4.4",
        "@types/node": "^26.6.6",
        "nodemon": "^3.1.14",
        "@skillit/typedoc": "^2.0.4",
        "typedoc": "^0.28.20"
    },
    "dependencies": {
        "@r47onfire/game-math": "github:r47onfire/game-math",
        "lib0": "^0.2.119"
    }
}
