{
    "name": "edit_me",
    "private": true,
    "version": "???",
    "description": "",
    "main": "src/index.ts",
    "type": "module",
    "sideEffects": false,
    "scripts": {
        "build": "bun run scripts/build.ts",
        "build:website": "bun run --sequential clean:dist clean:docs prepare build:docs && bun run scripts/build-website.ts",
        "build:docs": "bun typedoc",
        "dev": "bun run --parallel \"dev:*\"",
        "dev:serve": "python3 -m http.server -d docs",
        "dev:watch": "bun nodemon -e js,json,ts,css,md,html -w . --exec \"bun run build:website\"",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "prepare": "bun run build --minify",
        "clean:dist": "rm -rf dist/*",
        "clean:docs": "rm -rf docs/*"
    },
    "nodemonConfig": {
        "ignore": [
            "**/docs/**",
            "**/dist/**",
            "**/skills/**"
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/r47onfire/bun-typescript-template.git"
    },
    "keywords": [],
    "author": "",
    "license": "AGPL-3.0-only",
    "devDependencies": {
        "@types/bun": "^1.4.4",
        "@types/markdown-it": "^14.2.0",
        "@types/markdown-it-attrs": "^4.1.3",
        "@types/node": "^26.6.6",
        "@types/prismjs": "^1.26.6",
        "markdown-it": "^15.0.3",
        "markdown-it-attrs": "^5.0.1",
        "node-html-parser": "^9.0.6",
        "nodemon": "^3.1.14",
        "prismjs": "^1.30.0"
    },
    "dependencies": {
        "@skillit/typedoc": "^2.0.4",
        "typedoc": "^0.28.20"
    }
}
