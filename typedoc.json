{
    "entryPointStrategy": "expand",
    "tsconfig": "./tsconfig.json",
    "excludeExternals": true,
    "hideGenerator": true,
    "includeVersion": true,
    "disableSources": false,
    "skipErrorChecking": true,
    "disableGit": false,
    "sourceLinkTemplate": "https://github.com/r47onfire/nebula/blob/{gitRevision}/{path}#L{line}",
    // "favicon": "", // Add icon
    "useTsLinkResolution": true,
    "ignoredHighlightLanguages": [],
    "intentionallyNotExported": [],
    "externalSymbolLinkMappings": {},
    "sort": [
        "documents-first",
        "alphabetical",
        "kind",
        "enum-member-source-order"
    ],
    "plugin": ["@skillit/typedoc"],
    "llmsTxt": true,
    "llmsTxtOutDir": "docs",
    "out": "./docs",
    "projectDocuments": ["guides/index.md"],
    "readme": "website_landing.md",
    "searchInDocuments": true,
    "navigationLinks": {
        "GitHub": "https://github.com/r47onfire/nebula",
        "Backolon": "https://backolon.js.org"
    }
}
